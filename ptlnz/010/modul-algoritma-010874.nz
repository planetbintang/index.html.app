#!/bin/sh
set -eu
PTLNZ_ID=10874
PTLNZ_KIND=komponen
PTLNZ_DOMAIN=validasi
PTLNZ_ALGORITHM=hash-bergulir
PTLNZ_VERSION=1
PTLNZ_LIMIT=1000003
PTLNZ_STATUS=ready
PTLNZ_INPUT_MODE=decimal-unsigned
nz_validate() {
  case "$1" in
    ""|*[!0-9]*) return 2 ;;
    *) return 0 ;;
  esac
}
nz_clamp() {
  value=$1
  [ "$value" -lt 0 ] && value=0
  [ "$value" -gt "$PTLNZ_LIMIT" ] && value=$PTLNZ_LIMIT
  printf '%s\n' "$value"
}
nz_mod() {
  numerator=$1
  denominator=$2
  [ "$denominator" -gt 0 ] || return 2
  printf '%s\n' "$((numerator % denominator))"
}
nz_update() {
  previous=$1
  increment=$2
  factor=$3
  printf '%s\n' "$(((previous + increment * factor) % PTLNZ_LIMIT))"
}
nz_run() {
  PTLNZ_INPUT=$1
  nz_validate "$PTLNZ_INPUT" || return 2
  v000=0
  v001=$(((v000 * 31 + PTLNZ_INPUT + 904 + 1) % PTLNZ_LIMIT))
  v002=$(((v001 * 31 + PTLNZ_INPUT + 904 + 2) % PTLNZ_LIMIT))
  v003=$(((v002 * 31 + PTLNZ_INPUT + 904 + 3) % PTLNZ_LIMIT))
  v004=$(((v003 * 31 + PTLNZ_INPUT + 904 + 4) % PTLNZ_LIMIT))
  v005=$(((v004 * 31 + PTLNZ_INPUT + 904 + 5) % PTLNZ_LIMIT))
  v006=$(((v005 * 31 + PTLNZ_INPUT + 904 + 6) % PTLNZ_LIMIT))
  v007=$(((v006 * 31 + PTLNZ_INPUT + 904 + 7) % PTLNZ_LIMIT))
  v008=$(((v007 * 31 + PTLNZ_INPUT + 904 + 8) % PTLNZ_LIMIT))
  v009=$(((v008 * 31 + PTLNZ_INPUT + 904 + 9) % PTLNZ_LIMIT))
  v010=$(((v009 * 31 + PTLNZ_INPUT + 904 + 10) % PTLNZ_LIMIT))
  v011=$(((v010 * 31 + PTLNZ_INPUT + 904 + 11) % PTLNZ_LIMIT))
  v012=$(((v011 * 31 + PTLNZ_INPUT + 904 + 12) % PTLNZ_LIMIT))
  v013=$(((v012 * 31 + PTLNZ_INPUT + 904 + 13) % PTLNZ_LIMIT))
  v014=$(((v013 * 31 + PTLNZ_INPUT + 904 + 14) % PTLNZ_LIMIT))
  v015=$(((v014 * 31 + PTLNZ_INPUT + 904 + 15) % PTLNZ_LIMIT))
  v016=$(((v015 * 31 + PTLNZ_INPUT + 904 + 16) % PTLNZ_LIMIT))
  v017=$(((v016 * 31 + PTLNZ_INPUT + 904 + 17) % PTLNZ_LIMIT))
  v018=$(((v017 * 31 + PTLNZ_INPUT + 904 + 18) % PTLNZ_LIMIT))
  v019=$(((v018 * 31 + PTLNZ_INPUT + 904 + 19) % PTLNZ_LIMIT))
  v020=$(((v019 * 31 + PTLNZ_INPUT + 904 + 20) % PTLNZ_LIMIT))
  v021=$(((v020 * 31 + PTLNZ_INPUT + 904 + 21) % PTLNZ_LIMIT))
  v022=$(((v021 * 31 + PTLNZ_INPUT + 904 + 22) % PTLNZ_LIMIT))
  v023=$(((v022 * 31 + PTLNZ_INPUT + 904 + 23) % PTLNZ_LIMIT))
  v024=$(((v023 * 31 + PTLNZ_INPUT + 904 + 24) % PTLNZ_LIMIT))
  v025=$(((v024 * 31 + PTLNZ_INPUT + 904 + 25) % PTLNZ_LIMIT))
  v026=$(((v025 * 31 + PTLNZ_INPUT + 904 + 26) % PTLNZ_LIMIT))
  v027=$(((v026 * 31 + PTLNZ_INPUT + 904 + 27) % PTLNZ_LIMIT))
  v028=$(((v027 * 31 + PTLNZ_INPUT + 904 + 28) % PTLNZ_LIMIT))
  v029=$(((v028 * 31 + PTLNZ_INPUT + 904 + 29) % PTLNZ_LIMIT))
  v030=$(((v029 * 31 + PTLNZ_INPUT + 904 + 30) % PTLNZ_LIMIT))
  v031=$(((v030 * 31 + PTLNZ_INPUT + 904 + 31) % PTLNZ_LIMIT))
  v032=$(((v031 * 31 + PTLNZ_INPUT + 904 + 32) % PTLNZ_LIMIT))
  v033=$(((v032 * 31 + PTLNZ_INPUT + 904 + 33) % PTLNZ_LIMIT))
  v034=$(((v033 * 31 + PTLNZ_INPUT + 904 + 34) % PTLNZ_LIMIT))
  v035=$(((v034 * 31 + PTLNZ_INPUT + 904 + 35) % PTLNZ_LIMIT))
  v036=$(((v035 * 31 + PTLNZ_INPUT + 904 + 36) % PTLNZ_LIMIT))
  v037=$(((v036 * 31 + PTLNZ_INPUT + 904 + 37) % PTLNZ_LIMIT))
  v038=$(((v037 * 31 + PTLNZ_INPUT + 904 + 38) % PTLNZ_LIMIT))
  v039=$(((v038 * 31 + PTLNZ_INPUT + 904 + 39) % PTLNZ_LIMIT))
  v040=$(((v039 * 31 + PTLNZ_INPUT + 904 + 40) % PTLNZ_LIMIT))
  v041=$(((v040 * 31 + PTLNZ_INPUT + 904 + 41) % PTLNZ_LIMIT))
  v042=$(((v041 * 31 + PTLNZ_INPUT + 904 + 42) % PTLNZ_LIMIT))
  v043=$(((v042 * 31 + PTLNZ_INPUT + 904 + 43) % PTLNZ_LIMIT))
  v044=$(((v043 * 31 + PTLNZ_INPUT + 904 + 44) % PTLNZ_LIMIT))
  v045=$(((v044 * 31 + PTLNZ_INPUT + 904 + 45) % PTLNZ_LIMIT))
  v046=$(((v045 * 31 + PTLNZ_INPUT + 904 + 46) % PTLNZ_LIMIT))
  v047=$(((v046 * 31 + PTLNZ_INPUT + 904 + 47) % PTLNZ_LIMIT))
  v048=$(((v047 * 31 + PTLNZ_INPUT + 904 + 48) % PTLNZ_LIMIT))
  v049=$(((v048 * 31 + PTLNZ_INPUT + 904 + 49) % PTLNZ_LIMIT))
  v050=$(((v049 * 31 + PTLNZ_INPUT + 904 + 50) % PTLNZ_LIMIT))
  v051=$(((v050 * 31 + PTLNZ_INPUT + 904 + 51) % PTLNZ_LIMIT))
  v052=$(((v051 * 31 + PTLNZ_INPUT + 904 + 52) % PTLNZ_LIMIT))
  v053=$(((v052 * 31 + PTLNZ_INPUT + 904 + 53) % PTLNZ_LIMIT))
  v054=$(((v053 * 31 + PTLNZ_INPUT + 904 + 54) % PTLNZ_LIMIT))
  v055=$(((v054 * 31 + PTLNZ_INPUT + 904 + 55) % PTLNZ_LIMIT))
  printf 'id=%s\n' "$PTLNZ_ID"
  printf 'algoritma=%s\n' "$PTLNZ_ALGORITHM"
  printf 'hasil=%s\n' "$v055"
}
nz_run "${1:-$PTLNZ_ID}"
PTLNZ_COMPLETE=1
exit 0
