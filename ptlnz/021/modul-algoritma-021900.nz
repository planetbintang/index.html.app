  v017=$(((v016 + PTLNZ_INPUT * PTLNZ_ID % 118 + 963) % PTLNZ_LIMIT))
  v018=$(((v017 + PTLNZ_INPUT * PTLNZ_ID % 119 + 963) % PTLNZ_LIMIT))
  v019=$(((v018 + PTLNZ_INPUT * PTLNZ_ID % 120 + 963) % PTLNZ_LIMIT))
  v020=$(((v019 + PTLNZ_INPUT * PTLNZ_ID % 121 + 963) % PTLNZ_LIMIT))
  v021=$(((v020 + PTLNZ_INPUT * PTLNZ_ID % 122 + 963) % PTLNZ_LIMIT))
  v022=$(((v021 + PTLNZ_INPUT * PTLNZ_ID % 123 + 963) % PTLNZ_LIMIT))
