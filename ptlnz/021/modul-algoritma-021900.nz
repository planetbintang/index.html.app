  v038=$(((v037 + PTLNZ_INPUT * PTLNZ_ID % 139 + 963) % PTLNZ_LIMIT))
  v039=$(((v038 + PTLNZ_INPUT * PTLNZ_ID % 140 + 963) % PTLNZ_LIMIT))
  v040=$(((v039 + PTLNZ_INPUT * PTLNZ_ID % 141 + 963) % PTLNZ_LIMIT))
