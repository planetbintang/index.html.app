  v028=$(((v027 + PTLNZ_INPUT * PTLNZ_ID % 129 + 963) % PTLNZ_LIMIT))
  v029=$(((v028 + PTLNZ_INPUT * PTLNZ_ID % 130 + 963) % PTLNZ_LIMIT))
  v030=$(((v029 + PTLNZ_INPUT * PTLNZ_ID % 131 + 963) % PTLNZ_LIMIT))
  v031=$(((v030 + PTLNZ_INPUT * PTLNZ_ID % 132 + 963) % PTLNZ_LIMIT))
