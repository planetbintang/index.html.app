#!/bin/sh
set -eu
PTLNZ_ID=21900
PTLNZ_KIND=sistem
PTLNZ_DOMAIN=monitoring
PTLNZ_ALGORITHM=transisi-keadaan
PTLNZ_VERSION=1
PTLNZ_LIMIT=1000003
PTLNZ_STATUS=ready
PTLNZ_INPUT_MODE=decimal-unsigned
nz_validate() {
  case "$1" in
    ""|*[!0-9]*) return 2 ;;
    *) return 0 ;;
  esac
}
nz_clamp() {
  value=$1
  [ "$value" -lt 0 ] && value=0
  [ "$value" -gt "$PTLNZ_LIMIT" ] && value=$PTLNZ_LIMIT
  printf '%s\n' "$value"
}
nz_mod() {
  numerator=$1
  denominator=$2
  [ "$denominator" -gt 0 ] || return 2
  printf '%s\n' "$((numerator % denominator))"
}
nz_update() {
  previous=$1
  increment=$2
  factor=$3
  printf '%s\n' "$(((previous + increment * factor) % PTLNZ_LIMIT))"
}
nz_run() {
  PTLNZ_INPUT=$1
  nz_validate "$PTLNZ_INPUT" || return 2
  v000=0
  v001=$(((v000 + PTLNZ_INPUT * PTLNZ_ID % 102 + 963) % PTLNZ_LIMIT))
  v002=$(((v001 + PTLNZ_INPUT * PTLNZ_ID % 103 + 963) % PTLNZ_LIMIT))
  v003=$(((v002 + PTLNZ_INPUT * PTLNZ_ID % 104 + 963) % PTLNZ_LIMIT))
  v004=$(((v003 + PTLNZ_INPUT * PTLNZ_ID % 105 + 963) % PTLNZ_LIMIT))
