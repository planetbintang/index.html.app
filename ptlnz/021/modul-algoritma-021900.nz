  v051=$(((v050 + PTLNZ_INPUT * PTLNZ_ID % 152 + 963) % PTLNZ_LIMIT))
  v052=$(((v051 + PTLNZ_INPUT * PTLNZ_ID % 153 + 963) % PTLNZ_LIMIT))
  v053=$(((v052 + PTLNZ_INPUT * PTLNZ_ID % 154 + 963) % PTLNZ_LIMIT))
  v054=$(((v053 + PTLNZ_INPUT * PTLNZ_ID % 155 + 963) % PTLNZ_LIMIT))
  v055=$(((v054 + PTLNZ_INPUT * PTLNZ_ID % 156 + 963) % PTLNZ_LIMIT))
  printf 'id=%s\n' "$PTLNZ_ID"
  printf 'algoritma=%s\n' "$PTLNZ_ALGORITHM"
  printf 'hasil=%s\n' "$v055"
}
nz_run "${1:-$PTLNZ_ID}"
PTLNZ_COMPLETE=1
exit 0
