  v043=$(((v042 + PTLNZ_INPUT % 45 + 976) % PTLNZ_LIMIT))
  v044=$(((v043 + PTLNZ_INPUT % 46 + 976) % PTLNZ_LIMIT))
  v045=$(((v044 + PTLNZ_INPUT % 47 + 976) % PTLNZ_LIMIT))
  v046=$(((v045 + PTLNZ_INPUT % 48 + 976) % PTLNZ_LIMIT))
  v047=$(((v046 + PTLNZ_INPUT % 49 + 976) % PTLNZ_LIMIT))
  v048=$(((v047 + PTLNZ_INPUT % 50 + 976) % PTLNZ_LIMIT))
  v049=$(((v048 + PTLNZ_INPUT % 51 + 976) % PTLNZ_LIMIT))
  v050=$(((v049 + PTLNZ_INPUT % 52 + 976) % PTLNZ_LIMIT))
  v051=$(((v050 + PTLNZ_INPUT % 53 + 976) % PTLNZ_LIMIT))
  v052=$(((v051 + PTLNZ_INPUT % 54 + 976) % PTLNZ_LIMIT))
  v053=$(((v052 + PTLNZ_INPUT % 55 + 976) % PTLNZ_LIMIT))
