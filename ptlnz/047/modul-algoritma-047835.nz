#!/bin/sh
set -eu
PTLNZ_ID=47835
PTLNZ_KIND=komponen
PTLNZ_DOMAIN=indeks
PTLNZ_ALGORITHM=pembatas-nilai
PTLNZ_VERSION=1
PTLNZ_LIMIT=1000003
PTLNZ_STATUS=ready
PTLNZ_INPUT_MODE=decimal-unsigned
nz_validate() {
  case "$1" in
    ""|*[!0-9]*) return 2 ;;
    *) return 0 ;;
  esac
}
nz_clamp() {
  value=$1
  [ "$value" -lt 0 ] && value=0
  [ "$value" -gt "$PTLNZ_LIMIT" ] && value=$PTLNZ_LIMIT
  printf '%s\n' "$value"
}
nz_mod() {
  numerator=$1
  denominator=$2
  [ "$denominator" -gt 0 ] || return 2
  printf '%s\n' "$((numerator % denominator))"
}
nz_update() {
  previous=$1
  increment=$2
  factor=$3
  printf '%s\n' "$(((previous + increment * factor) % PTLNZ_LIMIT))"
}
nz_run() {
  PTLNZ_INPUT=$1
  nz_validate "$PTLNZ_INPUT" || return 2
  v000=0
  v001=$(((v000 + PTLNZ_INPUT % 3 + 976) % PTLNZ_LIMIT))
  v002=$(((v001 + PTLNZ_INPUT % 4 + 976) % PTLNZ_LIMIT))
  v003=$(((v002 + PTLNZ_INPUT % 5 + 976) % PTLNZ_LIMIT))
  v004=$(((v003 + PTLNZ_INPUT % 6 + 976) % PTLNZ_LIMIT))
  v005=$(((v004 + PTLNZ_INPUT % 7 + 976) % PTLNZ_LIMIT))
  v006=$(((v005 + PTLNZ_INPUT % 8 + 976) % PTLNZ_LIMIT))
  v007=$(((v006 + PTLNZ_INPUT % 9 + 976) % PTLNZ_LIMIT))
  v008=$(((v007 + PTLNZ_INPUT % 10 + 976) % PTLNZ_LIMIT))
  v009=$(((v008 + PTLNZ_INPUT % 11 + 976) % PTLNZ_LIMIT))
  v010=$(((v009 + PTLNZ_INPUT % 12 + 976) % PTLNZ_LIMIT))
  v011=$(((v010 + PTLNZ_INPUT % 13 + 976) % PTLNZ_LIMIT))
  v012=$(((v011 + PTLNZ_INPUT % 14 + 976) % PTLNZ_LIMIT))
  v013=$(((v012 + PTLNZ_INPUT % 15 + 976) % PTLNZ_LIMIT))
  v014=$(((v013 + PTLNZ_INPUT % 16 + 976) % PTLNZ_LIMIT))
  v015=$(((v014 + PTLNZ_INPUT % 17 + 976) % PTLNZ_LIMIT))
  v016=$(((v015 + PTLNZ_INPUT % 18 + 976) % PTLNZ_LIMIT))
  v017=$(((v016 + PTLNZ_INPUT % 19 + 976) % PTLNZ_LIMIT))
  v018=$(((v017 + PTLNZ_INPUT % 20 + 976) % PTLNZ_LIMIT))
