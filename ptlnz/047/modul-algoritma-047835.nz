  v020=$(((v019 + PTLNZ_INPUT % 22 + 976) % PTLNZ_LIMIT))
  v021=$(((v020 + PTLNZ_INPUT % 23 + 976) % PTLNZ_LIMIT))
  v022=$(((v021 + PTLNZ_INPUT % 24 + 976) % PTLNZ_LIMIT))
  v023=$(((v022 + PTLNZ_INPUT % 25 + 976) % PTLNZ_LIMIT))
  v024=$(((v023 + PTLNZ_INPUT % 26 + 976) % PTLNZ_LIMIT))
  v025=$(((v024 + PTLNZ_INPUT % 27 + 976) % PTLNZ_LIMIT))
  v026=$(((v025 + PTLNZ_INPUT % 28 + 976) % PTLNZ_LIMIT))
  v027=$(((v026 + PTLNZ_INPUT % 29 + 976) % PTLNZ_LIMIT))
  v028=$(((v027 + PTLNZ_INPUT % 30 + 976) % PTLNZ_LIMIT))
  v029=$(((v028 + PTLNZ_INPUT % 31 + 976) % PTLNZ_LIMIT))
  v030=$(((v029 + PTLNZ_INPUT % 32 + 976) % PTLNZ_LIMIT))
  v031=$(((v030 + PTLNZ_INPUT % 33 + 976) % PTLNZ_LIMIT))
  v032=$(((v031 + PTLNZ_INPUT % 34 + 976) % PTLNZ_LIMIT))
  v033=$(((v032 + PTLNZ_INPUT % 35 + 976) % PTLNZ_LIMIT))
  v034=$(((v033 + PTLNZ_INPUT % 36 + 976) % PTLNZ_LIMIT))
  v035=$(((v034 + PTLNZ_INPUT % 37 + 976) % PTLNZ_LIMIT))
  v036=$(((v035 + PTLNZ_INPUT % 38 + 976) % PTLNZ_LIMIT))
  v037=$(((v036 + PTLNZ_INPUT % 39 + 976) % PTLNZ_LIMIT))
