#!/bin/sh
set -eu
PTLNZ_ID=61302
PTLNZ_KIND=komponen
PTLNZ_DOMAIN=matematika
PTLNZ_ALGORITHM=rekurensi-affine
PTLNZ_VERSION=1
PTLNZ_LIMIT=1000003
PTLNZ_STATUS=ready
PTLNZ_INPUT_MODE=decimal-unsigned
nz_validate() {
  case "$1" in
    ""|*[!0-9]*) return 2 ;;
    *) return 0 ;;
  esac
}
nz_clamp() {
  value=$1
  [ "$value" -lt 0 ] && value=0
  [ "$value" -gt "$PTLNZ_LIMIT" ] && value=$PTLNZ_LIMIT
  printf '%s\n' "$value"
}
nz_mod() {
  numerator=$1
  denominator=$2
  [ "$denominator" -gt 0 ] || return 2
  printf '%s\n' "$((numerator % denominator))"
}
nz_update() {
  previous=$1
  increment=$2
  factor=$3
  printf '%s\n' "$(((previous + increment * factor) % PTLNZ_LIMIT))"
}
nz_run() {
  PTLNZ_INPUT=$1
  nz_validate "$PTLNZ_INPUT" || return 2
  v000=0
  v001=$(((v000 * 3 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v002=$(((v001 * 4 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v003=$(((v002 * 5 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v004=$(((v003 * 6 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v005=$(((v004 * 7 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v006=$(((v005 * 8 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v007=$(((v006 * 9 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v008=$(((v007 * 10 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v009=$(((v008 * 11 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v010=$(((v009 * 12 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v011=$(((v010 * 13 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v012=$(((v011 * 14 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v013=$(((v012 * 2 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v014=$(((v013 * 3 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v015=$(((v014 * 4 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v016=$(((v015 * 5 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v017=$(((v016 * 6 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v018=$(((v017 * 7 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v019=$(((v018 * 8 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v020=$(((v019 * 9 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v021=$(((v020 * 10 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v022=$(((v021 * 11 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v023=$(((v022 * 12 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v024=$(((v023 * 13 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v025=$(((v024 * 14 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v026=$(((v025 * 2 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v027=$(((v026 * 3 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v028=$(((v027 * 4 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v029=$(((v028 * 5 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v030=$(((v029 * 6 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v031=$(((v030 * 7 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v032=$(((v031 * 8 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v033=$(((v032 * 9 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v034=$(((v033 * 10 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v035=$(((v034 * 11 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v036=$(((v035 * 12 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v037=$(((v036 * 13 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v038=$(((v037 * 14 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v039=$(((v038 * 2 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v040=$(((v039 * 3 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v041=$(((v040 * 4 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v042=$(((v041 * 5 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v043=$(((v042 * 6 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v044=$(((v043 * 7 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v045=$(((v044 * 8 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v046=$(((v045 * 9 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v047=$(((v046 * 10 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v048=$(((v047 * 11 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v049=$(((v048 * 12 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v050=$(((v049 * 13 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v051=$(((v050 * 14 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v052=$(((v051 * 2 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v053=$(((v052 * 3 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v054=$(((v053 * 4 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  v055=$(((v054 * 5 + PTLNZ_INPUT + 485) % PTLNZ_LIMIT))
  printf 'id=%s\n' "$PTLNZ_ID"
  printf 'algoritma=%s\n' "$PTLNZ_ALGORITHM"
  printf 'hasil=%s\n' "$v055"
}
nz_run "${1:-$PTLNZ_ID}"
PTLNZ_COMPLETE=1
exit 0
