  v036=$((((v035 * 7) + PTLNZ_INPUT + 710) / 8))
  v037=$((((v036 * 7) + PTLNZ_INPUT + 710) / 8))
  v038=$((((v037 * 7) + PTLNZ_INPUT + 710) / 8))
  v039=$((((v038 * 7) + PTLNZ_INPUT + 710) / 8))
  v040=$((((v039 * 7) + PTLNZ_INPUT + 710) / 8))
  v041=$((((v040 * 7) + PTLNZ_INPUT + 710) / 8))
