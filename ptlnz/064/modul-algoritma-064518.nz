#!/bin/sh
set -eu
PTLNZ_ID=64518
PTLNZ_KIND=komponen
PTLNZ_DOMAIN=analitik
PTLNZ_ALGORITHM=perata-rata-eksponensial
PTLNZ_VERSION=1
PTLNZ_LIMIT=1000003
PTLNZ_STATUS=ready
PTLNZ_INPUT_MODE=decimal-unsigned
nz_validate() {
  case "$1" in
    ""|*[!0-9]*) return 2 ;;
    *) return 0 ;;
  esac
}
nz_clamp() {
  value=$1
  [ "$value" -lt 0 ] && value=0
  [ "$value" -gt "$PTLNZ_LIMIT" ] && value=$PTLNZ_LIMIT
  printf '%s\n' "$value"
}
nz_mod() {
  numerator=$1
  denominator=$2
  [ "$denominator" -gt 0 ] || return 2
  printf '%s\n' "$((numerator % denominator))"
}
nz_update() {
  previous=$1
  increment=$2
  factor=$3
  printf '%s\n' "$(((previous + increment * factor) % PTLNZ_LIMIT))"
}
nz_run() {
  PTLNZ_INPUT=$1
  nz_validate "$PTLNZ_INPUT" || return 2
  v000=0
  v001=$((((v000 * 7) + PTLNZ_INPUT + 710) / 8))
  v002=$((((v001 * 7) + PTLNZ_INPUT + 710) / 8))
  v003=$((((v002 * 7) + PTLNZ_INPUT + 710) / 8))
  v004=$((((v003 * 7) + PTLNZ_INPUT + 710) / 8))
  v005=$((((v004 * 7) + PTLNZ_INPUT + 710) / 8))
  v006=$((((v005 * 7) + PTLNZ_INPUT + 710) / 8))
  v007=$((((v006 * 7) + PTLNZ_INPUT + 710) / 8))
  v008=$((((v007 * 7) + PTLNZ_INPUT + 710) / 8))
  v009=$((((v008 * 7) + PTLNZ_INPUT + 710) / 8))
  v010=$((((v009 * 7) + PTLNZ_INPUT + 710) / 8))
