  v049=$((((v048 * 7) + PTLNZ_INPUT + 710) / 8))
  v050=$((((v049 * 7) + PTLNZ_INPUT + 710) / 8))
  v051=$((((v050 * 7) + PTLNZ_INPUT + 710) / 8))
  v052=$((((v051 * 7) + PTLNZ_INPUT + 710) / 8))
  v053=$((((v052 * 7) + PTLNZ_INPUT + 710) / 8))
  v054=$((((v053 * 7) + PTLNZ_INPUT + 710) / 8))
  v055=$((((v054 * 7) + PTLNZ_INPUT + 710) / 8))
  printf 'id=%s\n' "$PTLNZ_ID"
  printf 'algoritma=%s\n' "$PTLNZ_ALGORITHM"
  printf 'hasil=%s\n' "$v055"
}
nz_run "${1:-$PTLNZ_ID}"
PTLNZ_COMPLETE=1
exit 0
