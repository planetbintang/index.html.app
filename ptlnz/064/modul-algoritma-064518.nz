  v012=$((((v011 * 7) + PTLNZ_INPUT + 710) / 8))
  v013=$((((v012 * 7) + PTLNZ_INPUT + 710) / 8))
  v014=$((((v013 * 7) + PTLNZ_INPUT + 710) / 8))
  v015=$((((v014 * 7) + PTLNZ_INPUT + 710) / 8))
  v016=$((((v015 * 7) + PTLNZ_INPUT + 710) / 8))
  v017=$((((v016 * 7) + PTLNZ_INPUT + 710) / 8))
  v018=$((((v017 * 7) + PTLNZ_INPUT + 710) / 8))
  v019=$((((v018 * 7) + PTLNZ_INPUT + 710) / 8))
  v020=$((((v019 * 7) + PTLNZ_INPUT + 710) / 8))
  v021=$((((v020 * 7) + PTLNZ_INPUT + 710) / 8))
  v022=$((((v021 * 7) + PTLNZ_INPUT + 710) / 8))
  v023=$((((v022 * 7) + PTLNZ_INPUT + 710) / 8))
  v024=$((((v023 * 7) + PTLNZ_INPUT + 710) / 8))
  v025=$((((v024 * 7) + PTLNZ_INPUT + 710) / 8))
  v026=$((((v025 * 7) + PTLNZ_INPUT + 710) / 8))
  v027=$((((v026 * 7) + PTLNZ_INPUT + 710) / 8))
  v028=$((((v027 * 7) + PTLNZ_INPUT + 710) / 8))
  v029=$((((v028 * 7) + PTLNZ_INPUT + 710) / 8))
  v030=$((((v029 * 7) + PTLNZ_INPUT + 710) / 8))
  v031=$((((v030 * 7) + PTLNZ_INPUT + 710) / 8))
  v032=$((((v031 * 7) + PTLNZ_INPUT + 710) / 8))
